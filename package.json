{
  "name": "dealcheck",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DealCheck — was it cheaper before Black Friday? (60 Dev Minutes, Episode 001)",
  "scripts": {
    "dev": "npm run build:client && wrangler dev",
    "build:client": "vite build",
    "build": "npm run build:client && wrangler deploy --dry-run --outdir dist/worker",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "seed:gen": "node scripts/gen-seed.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build:client && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "hono": "4.13.22",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.2",
    "@cloudflare/workers-types": "5.20261125.1",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "4.1.12",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.168.0"
  }
}
