{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dealcheck",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // account_id is supplied via CLOUDFLARE_ACCOUNT_ID in the deployment environment.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "dealcheck.kratt.nz", "custom_domain": true }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker runs first so every response gets the CSP/security headers.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dealcheck-prod",
      // Replaced with the real ID after `wrangler d1 create dealcheck-prod` (not a secret).
      "database_id": "93d8b50b-4ab4-471a-8dbd-7a74cccf5c86",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    { "name": "dealcheck-investigation", "binding": "INVESTIGATION", "class_name": "InvestigationWorkflow" }
  ],
  "ratelimits": [
    { "name": "RL_ADMISSION", "namespace_id": "2001", "simple": { "limit": 6, "period": 60 } },
    { "name": "RL_POLL", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_INVALID", "namespace_id": "2003", "simple": { "limit": 20, "period": 60 } }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "RESEARCH_ENABLED": "false",
    "PROVIDER": "anthropic",
    "ANTHROPIC_MODEL": "claude-haiku-5-5",
    "DAILY_BUDGET_NZD": "25",
    "QUOTA_TOTAL": "10",
    "GLOBAL_CONCURRENCY": "5",
    "BUDGET_TIMEZONE": "Pacific/Auckland",
    "QUOTA_KEY_VERSION": "1",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGRsjy6m1ZCIH1HV",
    "PUBLICATION_URL": "https://60devminutes.substack.com/"
  },
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
  // Secrets (wrangler secret put): ANTHROPIC_API_KEY, QUOTA_HMAC_SECRET, SESSION_SECRET, TURNSTILE_SECRET_KEY
}
